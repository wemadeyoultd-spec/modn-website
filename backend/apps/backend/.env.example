# ===========================================================================
# Medusa backend environment (apps/backend)
# Copy to .env for local dev, or set these as service variables on Railway/Render.
# NEVER commit a real .env — only this .env.example is tracked.
# ===========================================================================

# --- Core ---------------------------------------------------------------------
# Node environment. Use "production" on the deployed server.
NODE_ENV=production

# PostgreSQL connection string.
# Local:   postgres://medusa:medusa@localhost:5432/medusa
# Railway: paste the "Postgres Connection URL" (it looks like
#          postgres://postgres:PASSWORD@HOST:PORT/railway). On Railway you can
#          also reference it as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://user:password@host:5432/database

# Set to "true" when your managed Postgres requires SSL (Railway and Render do).
# Leave empty/false for local Postgres.
DATABASE_SSL=true

# --- Redis (optional, recommended in production) ------------------------------
# When set, Medusa uses Redis for the event bus, cache and workflow engine.
# When empty, in-memory fallbacks are used (fine for a single instance / local).
# Railway: add a Redis plugin and reference ${{Redis.REDIS_URL}}.
# REDIS_URL=redis://default:password@host:6379

# --- Secrets ------------------------------------------------------------------
# Generate strong random values, e.g.  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-a-different-long-random-string

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowed origins. MUST include your live storefront domain and,
# if you use Vercel preview deploys, the preview URL. No trailing slashes.
#
# STORE_CORS  = storefront origins that call the /store API.
# ADMIN_CORS  = origins that load the admin dashboard (usually the backend URL).
# AUTH_CORS   = every origin that authenticates (storefront + admin).
STORE_CORS=https://kr.respectathletic.com,https://your-storefront.vercel.app,http://localhost:8000
ADMIN_CORS=https://your-backend.up.railway.app,http://localhost:9000,http://localhost:5173
AUTH_CORS=https://kr.respectathletic.com,https://your-storefront.vercel.app,https://your-backend.up.railway.app,http://localhost:8000,http://localhost:9000,http://localhost:5173

# --- Admin dashboard ----------------------------------------------------------
# Public URL of THIS backend, used by the admin bundle to call the API in prod.
# e.g. https://your-backend.up.railway.app  (no trailing slash)
MEDUSA_BACKEND_URL=https://your-backend.up.railway.app

# Set to "true" only on a worker-only instance to stop it serving the admin.
# MEDUSA_DISABLE_ADMIN=false

# Worker mode: shared (default, one instance does everything) | server | worker
# MEDUSA_WORKER_MODE=shared

# --- Stripe (optional) --------------------------------------------------------
# If unset, the Stripe payment provider is simply not registered and the server
# still boots. Set both to enable card payments.
# Secret key from the Stripe dashboard (starts with sk_live_ or sk_test_).
STRIPE_API_KEY=sk_test_replace_me
# Webhook signing secret (starts with whsec_) from the Stripe webhook you create
# pointing at https://your-backend.up.railway.app/hooks/payment/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me
