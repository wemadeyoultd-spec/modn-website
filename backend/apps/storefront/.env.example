# ===========================================================================
# Next.js storefront environment (apps/storefront)
# Copy to .env.local for local dev, or set these as Project Environment
# Variables in Vercel. NEXT_PUBLIC_* values are exposed to the browser.
# NEVER commit a real .env.local — only this .env.example is tracked.
# ===========================================================================

# Public URL of the Medusa backend API (the Railway backend URL in production).
# Local: http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-backend.up.railway.app

# Publishable API key that ties the storefront to a Medusa sales channel.
# Get it in the admin: Settings > Publishable API Keys (starts with pk_...),
# or from the seed output. Required — without it the store API returns 401.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Public base URL of the storefront itself, used for absolute/canonical URLs.
# Production: https://kr.respectathletic.com  (later https://respectathletic.com)
NEXT_PUBLIC_BASE_URL=https://kr.respectathletic.com

# Default region/country code the storefront opens in. "us" matches the seeded
# United States (USD) region.
NEXT_PUBLIC_DEFAULT_REGION=us

# Stripe publishable key (optional, only if using Stripe checkout).
# Starts with pk_live_ or pk_test_.
NEXT_PUBLIC_STRIPE_KEY=pk_test_replace_me

# Node environment.
NODE_ENV=production

# --- Optional: Medusa Cloud S3 image host (leave empty unless using it) --------
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
